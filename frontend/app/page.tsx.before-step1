'use client';

import { useEffect, useState } from 'react';
import Link from 'next/link';
import { ArrowRight, Film, LogIn } from 'lucide-react';

type Genre = {
  id: string;
  name: string;
};

type Movie = {
  id: string;
  title: string;
  posterUrl: string | null;
  backdropUrl: string | null;
  genres: Genre[];
};

const API_URL =
  process.env.NEXT_PUBLIC_API_URL || 'http://localhost:4000/api';

/* ============================================================
   POSTER WALL
============================================================ */

function PosterWall({ movies }: { movies: Movie[] }) {
  if (!movies.length) {
    return (
      <div className="absolute inset-0 bg-[#050505]">
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.05),transparent_55%)]" />
      </div>
    );
  }

  /*
   * Duplicate the movies so the wall has enough content
   * to cover large screens.
   */
  const posterMovies = [...movies, ...movies, ...movies];

  /*
   * Create several rows with slightly different movement.
   */
  const rows = [
    posterMovies.slice(0, 8),
    posterMovies.slice(6, 14),
    posterMovies.slice(12, 20),
    posterMovies.slice(18, 26),
    posterMovies.slice(24, 32),
  ];

  return (
    <div className="absolute inset-0 overflow-hidden bg-[#050505]">
      <div className="poster-wall">
        {rows.map((row, rowIndex) => (
          <div
            key={rowIndex}
            className={`poster-row poster-row-${rowIndex + 1}`}
          >
            {[...row, ...row].map((movie, index) => (
              <div
                key={`${movie.id}-${rowIndex}-${index}`}
                className="poster-item"
              >
                {movie.posterUrl ? (
                  <img
                    src={movie.posterUrl}
                    alt=""
                    draggable={false}
                  />
                ) : (
                  <div className="poster-placeholder">
                    <Film className="h-8 w-8" />
                  </div>
                )}
              </div>
            ))}
          </div>
        ))}
      </div>

      {/* Poster darkening */}
      <div className="absolute inset-0 bg-black/45" />

      {/* Center cinematic darkness */}
      <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,rgba(0,0,0,0.2)_35%,rgba(0,0,0,0.75)_100%)]" />

      {/* Strong center gradient behind text */}
      <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.25)_0%,rgba(0,0,0,0.7)_55%,rgba(0,0,0,0.92)_100%)]" />

      {/* Top and bottom cinematic gradients */}
      <div className="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/80 to-transparent" />

      <div className="absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-[#050505] via-[#050505]/80 to-transparent" />

      {/* Soft blur */}
      <div className="absolute inset-0 backdrop-blur-[1px]" />
    </div>
  );
}

/* ============================================================
   LANDING PAGE
============================================================ */

export default function LandingPage() {
  const [movies, setMovies] = useState<Movie[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    async function loadMovies() {
      try {
        const response = await fetch(`${API_URL}/movies?limit=40`);

        if (!response.ok) {
          throw new Error('Failed to fetch movies');
        }

        const data = await response.json();

        setMovies(data.movies || []);
      } catch (error) {
        console.error('Failed to load movies:', error);
      } finally {
        setLoading(false);
      }
    }

    loadMovies();
  }, []);

  return (
    <main className="relative min-h-screen overflow-hidden bg-[#050505] text-white">

      {/* ======================================================
          ANIMATED MOVIE POSTER BACKGROUND
      ====================================================== */}

      <PosterWall movies={movies} />

      {/* ======================================================
          NAVBAR
      ====================================================== */}

      <nav className="absolute inset-x-0 top-0 z-30">
        <div className="mx-auto flex h-24 max-w-[1600px] items-center justify-between px-6 md:px-10 lg:px-16">

          {/* Logo */}
          <Link
            href="/"
            className="group flex items-center gap-3"
          >
            <div className="flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 bg-white text-black shadow-xl transition duration-300 group-hover:scale-105">
              <Film className="h-5 w-5" />
            </div>

            <span className="text-lg font-bold tracking-[-0.02em] text-white">
              MovieRec
            </span>
          </Link>

          {/* Login */}
          <Link
            href="/login"
            className="flex items-center gap-2 rounded-full border border-white/10 bg-black/30 px-5 py-2.5 text-sm font-medium text-white/80 backdrop-blur-md transition duration-300 hover:border-white/20 hover:bg-white/10 hover:text-white"
          >
            <LogIn className="h-4 w-4" />
            Login
          </Link>
        </div>
      </nav>

      {/* ======================================================
          CINEMATIC INTRO
      ====================================================== */}

      <section className="relative z-10 flex min-h-screen items-center justify-center px-6 py-32">

        <div className="mx-auto w-full max-w-4xl text-center">

          {/* Brand */}
          <div
            className={`mb-7 transition-all duration-1000 ${
              loading
                ? 'translate-y-3 opacity-0'
                : 'translate-y-0 opacity-100'
            }`}
          >
            <span className="text-sm font-semibold uppercase tracking-[0.45em] text-white/70">
              MOVIEREC
            </span>
          </div>

          {/* Main heading */}
          <h1
            className={`mx-auto max-w-4xl text-5xl font-black leading-[0.95] tracking-[-0.055em] text-white transition-all delay-100 duration-1000 sm:text-6xl md:text-7xl lg:text-[92px] ${
              loading
                ? 'translate-y-5 opacity-0'
                : 'translate-y-0 opacity-100'
            }`}
          >
            Discover.
            <br />
            <span className="text-white/90">
              Rate. Remember.
            </span>
          </h1>

          {/* Description */}
          <p
            className={`mx-auto mt-7 max-w-xl text-base leading-7 text-white/65 transition-all delay-200 duration-1000 md:text-lg md:leading-8 ${
              loading
                ? 'translate-y-5 opacity-0'
                : 'translate-y-0 opacity-100'
            }`}
          >
            Find movies that match your taste, discover hidden gems,
            build your watchlist, and let MovieRec help you decide
            what to watch next.
          </p>

          {/* CTA */}
          <div
            className={`mt-9 transition-all delay-300 duration-1000 ${
              loading
                ? 'translate-y-5 opacity-0'
                : 'translate-y-0 opacity-100'
            }`}
          >
            <Link
              href="/register"
              className="group inline-flex items-center gap-3 rounded-full bg-white px-7 py-4 text-sm font-bold uppercase tracking-wide text-black shadow-2xl shadow-black/40 transition duration-300 hover:scale-105 hover:bg-zinc-200"
            >
              Start Exploring

              <ArrowRight className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </Link>
          </div>

          {/* Login prompt */}
          <p
            className={`mt-6 text-sm text-white/45 transition-all delay-500 duration-1000 ${
              loading
                ? 'translate-y-5 opacity-0'
                : 'translate-y-0 opacity-100'
            }`}
          >
            Already have an account?{' '}
            <Link
              href="/login"
              className="font-semibold text-white/75 underline-offset-4 transition hover:text-white hover:underline"
            >
              Login
            </Link>
          </p>

          {/* Closing phrase */}
          <div
            className={`mt-16 transition-all delay-700 duration-1000 ${
              loading
                ? 'translate-y-5 opacity-0'
                : 'translate-y-0 opacity-100'
            }`}
          >
            <p className="text-xs font-medium uppercase tracking-[0.3em] text-white/30">
              Your next story starts here.
            </p>
          </div>

        </div>
      </section>

      {/* ======================================================
          LOADING INDICATOR
      ====================================================== */}

      {loading && (
        <div className="absolute bottom-8 left-1/2 z-30 -translate-x-1/2">
          <div className="flex items-center gap-2 text-xs uppercase tracking-[0.25em] text-white/30">
            <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-white/50" />
            Loading your movies
          </div>
        </div>
      )}

      {/* ======================================================
          BOTTOM VIGNETTE
      ====================================================== */}

      <div className="pointer-events-none absolute inset-0 z-20 shadow-[inset_0_0_180px_rgba(0,0,0,0.75)]" />

    </main>
  );
}
