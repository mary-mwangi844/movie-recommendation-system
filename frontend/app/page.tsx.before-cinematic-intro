'use client';

import { useEffect, useState } from 'react';
import Link from 'next/link';
import { Film, Sparkles, Play } from 'lucide-react';

type Genre = {
  id: string;
  name: string;
};

type Movie = {
  id: string;
  title: string;
  description: string;
  releaseYear: number;
  runtime: number | null;
  posterUrl: string | null;
  backdropUrl: string | null;
  trailerUrl: string | null;
  tmdbId: number | null;
  averageRating: number;
  totalRatings: number;
  views: number;
  popularity: number;
  genres: Genre[];
};

const API_URL =
  process.env.NEXT_PUBLIC_API_URL || 'http://localhost:4000/api';

/* ============================================================
   ANIMATED POSTER WALL
============================================================ */

function PosterWall({ movies }: { movies: Movie[] }) {
  const posters = movies.filter((movie) => movie.posterUrl);

  if (!posters.length) {
    return (
      <div className="absolute inset-0 bg-[#050505]" />
    );
  }

  /*
   * Duplicate the posters so the wall feels dense even when
   * the database contains only a small number of movies.
   */
  const wallMovies = [...posters, ...posters, ...posters];

  const columns = [
    wallMovies.slice(0, 8),
    wallMovies.slice(8, 16),
    wallMovies.slice(16, 24),
    wallMovies.slice(24, 32),
    wallMovies.slice(32, 40),
    wallMovies.slice(40, 48),
    wallMovies.slice(48, 56),
  ];

  return (
    <div className="absolute inset-0 overflow-hidden bg-black">
      <div className="absolute inset-[-15%] flex gap-4 opacity-70 md:gap-5">
        {columns.map((column, columnIndex) => (
          <div
            key={columnIndex}
            className={`flex w-[130px] min-w-[130px] flex-col gap-4 md:w-[170px] md:min-w-[170px] md:gap-5 ${
              columnIndex % 2 === 0
                ? 'animate-poster-scroll-up'
                : 'animate-poster-scroll-down'
            }`}
          >
            {[...column, ...column].map((movie, index) => (
              <div
                key={`${movie.id}-${columnIndex}-${index}`}
                className="relative aspect-[2/3] overflow-hidden rounded-lg bg-zinc-900 shadow-2xl"
              >
                <img
                  src={movie.posterUrl!}
                  alt=""
                  className="h-full w-full object-cover"
                  loading="eager"
                />

                <div className="absolute inset-0 bg-black/20" />
              </div>
            ))}
          </div>
        ))}
      </div>

      {/* Heavy cinematic treatment */}
      <div className="absolute inset-0 bg-black/45" />

      <div className="absolute inset-0 bg-gradient-to-r from-black via-black/70 to-black/30" />

      <div className="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black" />

      <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,rgba(0,0,0,0.35)_45%,rgba(0,0,0,0.9)_100%)]" />

      {/* Slight blur keeps the text readable */}
      <div className="absolute inset-0 backdrop-blur-[1px]" />
    </div>
  );
}

