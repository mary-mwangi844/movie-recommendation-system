"use client";

import { FormEvent, useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";

const API_URL =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:4000/api";

export default function LoginPage() {
  const router = useRouter();

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();

    setError("");
    setLoading(true);

    try {
      const response = await fetch(`${API_URL}/auth/login`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          email,
          password,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          Array.isArray(data?.message)
            ? data.message.join(", ")
            : data?.message || "Invalid email or password."
        );
      }

      // Save whichever token your backend returns.
      if (data?.access_token) {
        localStorage.setItem("access_token", data.access_token);
      }

      if (data?.token) {
        localStorage.setItem("token", data.token);
      }

      // Save the user if the backend returns user information.
      if (data?.user) {
        localStorage.setItem("user", JSON.stringify(data.user));
      }

      router.push("/dashboard");
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Something went wrong. Please try again."
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <main className="login-page">
      {/* =====================================================
          LEFT SIDE — CINEMATIC VISUAL
      ====================================================== */}
      <section className="login-visual">
        <div className="login-visual-overlay" />

        {/* Decorative film elements */}
        <div
          className="film-strip film-strip-one"
          aria-hidden="true"
        >
          <span>✦</span>
          <span>◉</span>
          <span>✦</span>
          <span>◉</span>
        </div>

        <div
          className="film-strip film-strip-two"
          aria-hidden="true"
        >
          <span>◉</span>
          <span>✦</span>
          <span>◉</span>
          <span>✦</span>
        </div>

        <div className="visual-content">
          <span className="visual-kicker">
            YOUR NEXT STORY
          </span>

          <h2>
            Find something
            <br />
            worth watching.
          </h2>

          <p>
            Discover movies that match your taste,
            explore hidden gems, and find your next
            favorite story.
          </p>

          <div className="visual-line" />
        </div>
      </section>

      {/* =====================================================
          RIGHT SIDE — LOGIN CONTENT
      ====================================================== */}
      <section className="login-content">
        {/* TOP BAR */}
        <div className="login-topbar">
          <Link
            href="/"
            className="login-logo"
          >
            MOVIEREC
          </Link>

          <Link
            href="/"
            className="back-link"
          >
            ← Back to MovieRec
          </Link>
        </div>

        {/* LOGIN FORM AREA */}
        <div className="login-card">
          <div className="login-heading">
            <span className="login-eyebrow">
              WELCOME BACK
            </span>

            <h1>
              Welcome back
            </h1>

            <p>
              Continue your movie journey.
            </p>
          </div>

          <form
            className="login-form"
            onSubmit={handleSubmit}
          >
            {/* EMAIL */}
            <div className="form-group">
              <label htmlFor="email">
                Email address
              </label>

              <input
                id="email"
                name="email"
                type="email"
                value={email}
                onChange={(event) =>
                  setEmail(event.target.value)
                }
                placeholder="you@example.com"
                autoComplete="email"
                required
              />
            </div>

            {/* PASSWORD */}
            <div className="form-group">
              <label htmlFor="password">
                Password
              </label>

              <input
                id="password"
                name="password"
                type="password"
                value={password}
                onChange={(event) =>
                  setPassword(event.target.value)
                }
                placeholder="Enter your password"
                autoComplete="current-password"
                required
              />
            </div>

            {/* ERROR MESSAGE */}
            {error && (
              <div
                className="login-error"
                role="alert"
              >
                {error}
              </div>
            )}

            {/* SIGN IN BUTTON */}
            <button
              type="submit"
              className="login-button"
              disabled={loading}
            >
              {loading ? "SIGNING IN..." : "SIGN IN"}
            </button>
          </form>

          {/* SIGN UP */}
          <p className="signup-prompt">
            Don't have an account?{" "}
            <Link href="/register">
              Sign up
            </Link>
          </p>
        </div>

        {/* BOTTOM MESSAGE */}
        <div className="login-footer-message">
          <span>✦</span>

          <p>
            Discover something worth watching.
          </p>

          <span>✦</span>
        </div>
      </section>
    </main>
  );
}
